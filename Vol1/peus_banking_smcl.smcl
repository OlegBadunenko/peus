{space 9}rts {c |}{res}      1,577    1.038153    .0247121   .9531643   1.129716
{txt}
{com}. 
. generate rts_lb = rts - ${c -(}critical_value{c )-} * rts_se  if e(sample)
{txt}(6,662 missing values generated)

{com}. generate rts_ub = rts + ${c -(}critical_value{c )-} * rts_se if e(sample)
{txt}(6,662 missing values generated)

{com}. generate scale = "" if e(sample)
{txt}(8,239 missing values generated)

{com}. 
. replace scale = "Economies of Scale" if rts_lb > 1 & e(sample)
{txt}variable {bf}{res}scale{sf}{txt} was {bf}{res}str1{sf}{txt} now {bf}{res}str18{sf}
{txt}(1,315 real changes made)

{com}. replace scale = "Diseconomies of Scale" if rts_ub < 1 & e(sample)
{txt}variable {bf}{res}scale{sf}{txt} was {bf}{res}str18{sf}{txt} now {bf}{res}str21{sf}
{txt}(38 real changes made)

{com}. replace scale = "Optimal Scale" if rts_lb < 1 & rts_ub > 1 & e(sample)
{txt}(224 real changes made)

{com}. 
. tabulate scale

