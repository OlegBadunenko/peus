.         
. 
. **## RTS manually
. 
. * Extract coefficient names from e(b)
. matrix b = e(b)
{txt}
{com}. local allvars : colnames b
{txt}
{com}. 
. * Initialize locals
. local dlnY1
{txt}
{com}. local dlnY2
{txt}
{com}. 
. foreach var of local allvars {c -(}
{txt}  2{com}.     * lnY1 terms
.     if strpos("`var'", "lnY1") {c -(}
{txt}  3{com}.         if strpos("`var'", "#") {c -(}
{txt}  4{com}.             local left = substr("`var'", 1, strpos("`var'", "#") - 1)
{txt}  5{com}.             local right = substr("`var'", strpos("`var'", "#") + 1, .)
{txt}  6{com}. 
.             if "`left'" == "c.lnY1" & "`right'" == "c.lnY1" {c -(}
{txt}  7{com}.                 local dlnY1 `dlnY1' + 2*_b[`var']*lnY1
{txt}  8{com}.             {c )-}
{txt}  9{com}.             else if "`left'" == "c.lnY1" {c -(}
{txt} 10{com}.                 local other = subinstr("`right'", "c.", "", .)
{txt} 11{com}.                 local dlnY1 `dlnY1' + _b[`var']*`other'
{txt} 12{com}.             {c )-}
{txt} 13{com}.             else if "`right'" == "c.lnY1" {c -(}
{txt} 14{com}.                 local other = subinstr("`left'", "c.", "", .)
{txt} 15{com}.                 local dlnY1 `dlnY1' + _b[`var']*`other'
{txt} 16{com}.             {c )-}
{txt} 17{com}.         {c )-}
{txt} 18{com}.         else if "`var'" == "lnY1" {c -(}
{txt} 19{com}.             local dlnY1 `dlnY1' + _b[`var']
{txt} 20{com}.         {c )-}
{txt} 21{com}.     {c )-}
{txt} 22{com}. 
.     * lnY2 terms
.     if strpos("`var'", "lnY2") {c -(}
{txt} 23{com}.         if strpos("`var'", "#") {c -(}
{txt} 24{com}.             local left = substr("`var'", 1, strpos("`var'", "#") - 1)
{txt} 25{com}.             local right = substr("`var'", strpos("`var'", "#") + 1, .)
{txt} 26{com}. 
.             if "`left'" == "c.lnY2" & "`right'" == "c.lnY2" {c -(}
{txt} 27{com}.                 local dlnY2 `dlnY2' + 2*_b[`var']*lnY2
{txt} 28{com}.             {c )-}
{txt} 29{com}.             else if "`left'" == "c.lnY2" {c -(}
{txt} 30{com}.                 local other = subinstr("`right'", "c.", "", .)
{txt} 31{com}.                 local dlnY2 `dlnY2' + _b[`var']*`other'
{txt} 32{com}.             {c )-}
{txt} 33{com}.             else if "`right'" == "c.lnY2" {c -(}
{txt} 34{com}.                 local other = subinstr("`left'", "c.", "", .)
{txt} 35{com}.                 local dlnY2 `dlnY2' + _b[`var']*`other'
{txt} 36{com}.             {c )-}
{txt} 37{com}.         {c )-}
{txt} 38{com}.         else if "`var'" == "lnY2" {c -(}
{txt} 39{com}.             local dlnY2 `dlnY2' + _b[`var']
{txt} 40{com}.         {c )-}
{txt} 41{com}.     {c )-}
{txt} 42{com}. {c )-}
{txt}
{com}. 
. 
. * Display the results
. display "Marginal effect of lnY1: `dlnY1'"
{res}Marginal effect of lnY1: + _b[lnY1] + 2*_b[c.lnY1#c.lnY1]*lnY1 + _b[c.lnY1#c.lnY2]*lnY2 + _b[c.lnY1#c.lnX2]*lnX2 + _b[c.lnY1#c.lnX3]*lnX3 + _b[c.lnY1#c.lnX4]*lnX4
{txt}
{com}. display "Marginal effect of lnY2: `dlnY2'"
{res}Marginal effect of lnY2: + _b[lnY2] + _b[c.lnY1#c.lnY2]*lnY1 + 2*_b[c.lnY2#c.lnY2]*lnY2 + _b[c.lnY2#c.lnX2]*lnX2 + _b[c.lnY2#c.lnX3]*lnX3 + _b[c.lnY2#c.lnX4]*lnX4
{txt}
{com}. 
. 
. * Temporarily store the expression
. local temp1 = "`dlnY1'"
{txt}
{com}. local temp2 = "`dlnY2'"
{txt}
{com}. 
. * Remove the first "+ " manually
. if substr("`temp1'", 1, 2) == "+ " {c -(}
.     local dlnY1 = substr("`temp1'", 3, .)
. {c )-}
{txt}
{com}. if substr("`temp2'", 1, 2) == "+ " {c -(}
.     local dlnY2 = substr("`temp2'", 3, .)
. {c )-}
{txt}
{com}. 
. * Display the results
. display "Marginal effect of lnY1: `dlnY1'"
{res}Marginal effect of lnY1: _b[lnY1] + 2*_b[c.lnY1#c.lnY1]*lnY1 + _b[c.lnY1#c.lnY2]*lnY2 + _b[c.lnY1#c.lnX2]*lnX2 + _b[c.lnY1#c.lnX3]*lnX3 + _b[c.lnY1#c.lnX4]*lnX4
{txt}
{com}. display "Marginal effect of lnY2: `dlnY2'"
{res}Marginal effect of lnY2: _b[lnY2] + _b[c.lnY1#c.lnY2]*lnY1 + 2*_b[c.lnY2#c.lnY2]*lnY2 + _b[c.lnY2#c.lnX2]*lnX2 + _b[c.lnY2#c.lnX3]*lnX3 + _b[c.lnY2#c.lnX4]*lnX4
{txt}
{com}. 
. 
. generate elast_Y1_manual = -(`dlnY1') if e(sample)
{txt}(6,662 missing values generated)

{com}. generate elast_Y2_manual = -(`dlnY2') if e(sample)
{txt}(6,662 missing values generated)

{com}. 
. local RTS_expr = "- 1 / ((`dlnY1') + (`dlnY2'))"
{txt}
{com}. 
. predictnl rts_manual = `RTS_expr' if e(sample), se(rts_se)
{txt}(6,662 missing values generated)

{com}. 
. summarize elast_Y1_manual elast_Y1 elast_Y2_manual elast_Y2 rts_manual rts

{txt}    Variable {c |}        Obs        Mean    Std. dev.       Min        Max
{hline 13}{c +}{hline 57}
elast_Y1_m~l {c |}{res}      1,577     .722717     .121999   .2231594   1.301317
{txt}{space 4}elast_Y1 {c |}{res}      1,577     .722717     .121999   .2231594   1.301317
{txt}elast_Y2_m~l {c |}{res}      1,577    .2410844     .107797  -.2876883   .6620186
{txt}{space 4}elast_Y2 {c |}{res}      1,577    .2410844     .107797  -.2876883   .6620186
{txt}{space 2}rts_manual {c |}{res}      1,577    1.038153    .0247121   .9531643   1.129716
