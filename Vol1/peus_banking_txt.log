. **## RTS manually
. 
. * Extract coefficient names from e(b)
. matrix b = e(b)

. local allvars : colnames b

. 
. * Initialize locals
. local dlnY1

. local dlnY2

. 
. foreach var of local allvars {
  2.     * lnY1 terms
.     if strpos("`var'", "lnY1") {
  3.         if strpos("`var'", "#") {
  4.             local left = substr("`var'", 1, strpos("`var'", "#") - 1)
  5.             local right = substr("`var'", strpos("`var'", "#") + 1, .)
  6. 
.             if "`left'" == "c.lnY1" & "`right'" == "c.lnY1" {
  7.                 local dlnY1 `dlnY1' + 2*_b[`var']*lnY1
  8.             }
  9.             else if "`left'" == "c.lnY1" {
 10.                 local other = subinstr("`right'", "c.", "", .)
 11.                 local dlnY1 `dlnY1' + _b[`var']*`other'
 12.             }
 13.             else if "`right'" == "c.lnY1" {
 14.                 local other = subinstr("`left'", "c.", "", .)
 15.                 local dlnY1 `dlnY1' + _b[`var']*`other'
 16.             }
 17.         }
 18.         else if "`var'" == "lnY1" {
 19.             local dlnY1 `dlnY1' + _b[`var']
 20.         }
 21.     }
 22. 
.     * lnY2 terms
.     if strpos("`var'", "lnY2") {
 23.         if strpos("`var'", "#") {
 24.             local left = substr("`var'", 1, strpos("`var'", "#") - 1)
 25.             local right = substr("`var'", strpos("`var'", "#") + 1, .)
 26. 
.             if "`left'" == "c.lnY2" & "`right'" == "c.lnY2" {
 27.                 local dlnY2 `dlnY2' + 2*_b[`var']*lnY2
 28.             }
 29.             else if "`left'" == "c.lnY2" {
 30.                 local other = subinstr("`right'", "c.", "", .)
 31.                 local dlnY2 `dlnY2' + _b[`var']*`other'
 32.             }
 33.             else if "`right'" == "c.lnY2" {
 34.                 local other = subinstr("`left'", "c.", "", .)
 35.                 local dlnY2 `dlnY2' + _b[`var']*`other'
 36.             }
 37.         }
 38.         else if "`var'" == "lnY2" {
 39.             local dlnY2 `dlnY2' + _b[`var']
 40.         }
 41.     }
 42. }

