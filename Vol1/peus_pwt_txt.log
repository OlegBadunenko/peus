y1    2.729168  -1.0141677  -.09768193   .13068275  -.01425271  -8.5116221   -11.81004  -5.5279341   .25531747

. 
. // To obtain starting values
. 
. local colnames : colnames init_b

. display "`colnames'"
lnK lnHL c.lnK#c.lnK c.lnK#c.lnHL c.lnHL#c.lnHL _cons _cons _cons _cons

. 
. // In Stata matrices, you need to use the equation names (rownames/colnames with equation prefixes) or use coleq() to get t
> he equation names.
. 
. // Get equation names
. local coleq : coleq init_b

. display "Equation names: `coleq'"
Equation names: Frontier Frontier Frontier Frontier Frontier Frontier Usigma Vsigma Theta

. 
. // Find columns where equation name is "Frontier"
. local first_col = .

. local last_col = .

. local col_num = 1

. foreach eq of local coleq {
  2.     if "`eq'" == "Frontier" {
  3.         if `first_col' == . local first_col = `col_num'
  4.         local last_col = `col_num'
  5.     }
  6.     local col_num = `col_num' + 1
  7. }

. 
. display "First Frontier column: `first_col'"
First Frontier column: 1

. display "Last Frontier column: `last_col'"
Last Frontier column: 6

. 
. matrix frontier_part = init_b[1..., `first_col'..`last_col']

. matrix list frontier_part

frontier_part[1,6]
