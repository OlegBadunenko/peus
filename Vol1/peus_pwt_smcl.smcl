. **# Panel data SF models
. 
. use "pwt_final.dta", clear         /* Calling dataset with modifications */
{txt}
{com}. 
. 
. capture drop sample_panel
{txt}
{com}. generate sample_panel = cn_oecd & year >= $CSyear
{txt}
{com}. // Make unbalanced panel data
. replace sample_panel = 0 if countrycode == "FRA" & year >= $CSyear & year <= $CSyear + 1
{txt}(2 real changes made)

{com}. replace sample_panel = 0 if countrycode == "DEU" & year >= $CSyear & year <= $CSyear + 1
{txt}(2 real changes made)

{com}. replace sample_panel = 0 if countrycode == "NLD" & year >= $CSyear & year <= $CSyear + 2
{txt}(3 real changes made)

{com}. replace sample_panel = 0 if countrycode == "NZL" & year >= $CSyear & year <= $CSyear + 2
{txt}(3 real changes made)

{com}. // Make an indicator for a single year (reporting time-invariant efficieincies); in the year $CSyear + 5, we definitely have all 38 countries
. generate sample_panel_one_year = cn_oecd & year == $CSyear + 5
{txt}
{com}. 
. **# last year available
. capture drop year_last_available
{txt}
{com}. bysort id: egen year_last_available = max(year) if sample_panel
{txt}(12,060 missing values generated)

{com}. 
