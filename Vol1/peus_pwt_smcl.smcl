LR test of sigma_u=0: {help j_chibar##|_new:chibar2(01) = }{res}0.15{col 56}{txt}Prob >= chibar2 = {res}0.351
{txt}
{com}. predict `spePWTT_xb' if e(sample), xb
{txt}(12,772 missing values generated)

{com}. generate `spePWTT_res' = lnY - `spePWTT_xb' if e(sample)
{txt}(12,772 missing values generated)

{com}. local prod = 1 // -1 for the cost function
{txt}
{com}. generate double `spePWTT_mu' = -`prod' * `spePWTT_res' * ///
>                 e(sigma_u)^2 / (e(sigma_u)^2+e(sigma_v)^2) ///
>                 if e(sample) // e(sigma_u) and e(sigma_v) come from estimation
{txt}(12,772 missing values generated)

{com}. generate double `spePWTT_sigma' = e(sigma_u) * e(sigma_v) / ///
>                 sqrt( e(sigma_u)^2 + e(sigma_v)^2 ) if e(sample)
{txt}(12,772 missing values generated)

{com}. generate `spePWTT_z'  = `spePWTT_mu'/`spePWTT_sigma'
{txt}(12,772 missing values generated)

{com}. 
. local alpha 0.05
{txt}
{com}. generate `spePWTT_zu' = invnormal(1 - (1- (`alpha')/2) * normal(`spePWTT_z')  )
{txt}(12,772 missing values generated)

{com}. generate `spePWTT_zl' = invnormal(1 - ((`alpha')/2) * normal(`spePWTT_z')  )
{txt}(12,772 missing values generated)

{com}. 
. generate man_LB95 = exp(-`spePWTT_mu' - `spePWTT_zl' * `spePWTT_sigma')
{txt}(12,772 missing values generated)

{com}. generate man_UB95 = exp(-`spePWTT_mu' - `spePWTT_zu' * `spePWTT_sigma')
{txt}(12,772 missing values generated)

{com}. 
. list country sfc_* man_* if !missing(sfc)
