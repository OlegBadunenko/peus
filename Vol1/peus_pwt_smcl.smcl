. // Manually
. // Step 1: Extract dependent variable
. local depvar : word 1 of $spePWTTL
{txt}
{com}. 
. // Step 2: Define raw variables
. capture drop lnKsq
{txt}
{com}. generate lnKsq = lnK^2
{txt}(2,496 missing values generated)

{com}. capture drop lnHLsq
{txt}
{com}. generate lnHLsq = lnHL^2
{txt}(4,569 missing values generated)

{com}. capture drop lnKlnHL
{txt}
{com}. generate lnKlnHL = lnHL*lnK
{txt}(4,609 missing values generated)

{com}. 
. local rawvars lnK lnHL lnKsq lnHLsq lnKlnHL
{txt}
{com}. 
. // Step 3: Generate means with suffix _mean
. foreach var of local rawvars {c -(}
{txt}  2{com}.         capture drop `var'_mean
{txt}  3{com}.     egen `var'_mean = mean(`var') if sample_panel, by(id)
{txt}  4{com}. {c )-}
