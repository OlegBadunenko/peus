{com}. generate te_panel_PWT_SS_xtreg = exp(-u_star_xtreg)
{txt}(12,060 missing values generated)

{com}. 
. egen u_star_reghdfe = max(alphas_reghdfe) if sample_panel
{txt}(12,060 missing values generated)

