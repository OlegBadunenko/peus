. **## Specifications
. 
. describe rgdpo emp cn hc

{txt}Variable      Storage   Display    Value
    name         type    format    label      Variable label
{hline}
{p 0 48}{res}{bind:rgdpo          }{txt}{bind: float   }{bind:%14.3g    }{space 1}{bind:         }{bind:  }{res}{res}Output-side real GDP at chained PPPs (in mil. 2017US$){p_end}
{p 0 48}{bind:emp            }{txt}{bind: float   }{bind:%9.0g     }{space 1}{bind:         }{bind:  }{res}{res}Number of persons engaged (in millions){p_end}
{p 0 48}{bind:cn             }{txt}{bind: float   }{bind:%9.0g     }{space 1}{bind:         }{bind:  }{res}{res}Capital stock at current PPPs (in mil. 2017US$){p_end}
{p 0 48}{bind:hc             }{txt}{bind: float   }{bind:%9.0g     }{space 1}{bind:         }{stata "notes list hc":*} {res}Human capital index, see note hc{p_end}
{txt}
{com}. 
. generate double lnY = log(rgdpo)
{txt}(2,411 missing values generated)

{com}. generate double lnL = log(emp)
{txt}(3,281 missing values generated)

{com}. generate double lnK = log(cn)
{txt}(2,496 missing values generated)

{com}. generate double lnH = log(hc)
{txt}(4,173 missing values generated)

{com}. 
. generate double lny = lnY - lnL
{txt}(3,281 missing values generated)

{com}. generate double lnk = lnK - lnL
{txt}(3,331 missing values generated)

{com}. generate double lnh = lnH - lnL
{txt}(4,569 missing values generated)

{com}. 
. generate double lnHL = lnH + lnL
{txt}(4,569 missing values generated)

{com}. 
. global spePWTCD "lnY lnK lnHL"
{txt}
{com}. 
. global spePWTTL "lnY (c.lnK c.lnHL)##(c.lnK c.lnHL)"
{txt}
{com}. 
. generate double half = 0.5
{txt}
{com}. global spePWTTL2 "lnY lnK lnHL c.lnK#c.lnHL c.half#(c.lnK#c.lnK c.lnHL#c.lnHL)"
{txt}
{com}. 
. keep countrycode country cn_oecd year id lnY lnL lnK lnH half lny lnk lnh lnHL 
{txt}
{com}. 
. save "pwt_final.dta", replace    /* Saving dataset with modifications */
{txt}{p 0 4 2}
file {bf}
pwt_final.dta{rm}
saved
{p_end}

{com}. 
. 
. **# Cross-Sectional SF models
. 
. use "pwt_final.dta", clear         /* Calling dataset with modifications */
