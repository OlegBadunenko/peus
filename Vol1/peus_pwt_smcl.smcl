. // Display the list to verify
. display "`vars'"
{res}lnK lnHL c.lnK#c.lnK c.lnK#c.lnHL c.lnHL#c.lnHL
{txt}
{com}. 
. capture drop y_fitted_no_intercept
{txt}
{com}. generate double y_fitted_no_intercept = 0 if e(sample)
{txt}(12,060 missing values generated)

{com}. 
. foreach var of local vars {c -(}
{txt}  2{com}.     replace y_fitted_no_intercept = y_fitted_no_intercept + _b[`var'] * `var'
{txt}  3{com}. {c )-}
{txt}(750 real changes made)
(750 real changes made)
(750 real changes made)
(750 real changes made)
(750 real changes made)

{com}. 
. capture drop alphas
{txt}
{com}. generate double alphas = y_fitted_with_intercepts - y_fitted_no_intercept
{txt}(12,060 missing values generated)

{com}. summarize alphas

{txt}    Variable {c |}        Obs        Mean    Std. dev.       Min        Max
{hline 13}{c +}{hline 57}
{space 6}alphas {c |}{res}        750   -.0000213    .1886107   -.504574   .5679577
{txt}
{com}. 
. // Step 1: Compute alpha_t = max(alpha_it) within each year, only for sample
. egen alpha_t = max(alphas) if e(sample), by(year)
{txt}(12,060 missing values generated)

{com}. 
. // Step 2: Compute uhat = alpha_t - alpha_it, only for sample
. generate uhat = alpha_t - alphas if e(sample)
{txt}(12,060 missing values generated)

{com}. 
. generate double te_panel_PWT_CSS_FE = exp(-uhat)
{txt}(12,060 missing values generated)

{com}. label variable te_panel_PWT_CSS_FE "Technical efficiency, CSS model"
