{txt}      sigma_u {c |}{col 15}{res}{space 2} .1747152{col 27}{space 2} .1683935{col 55}{space 4} .0264197{col 68}{space 3} 1.155403
{txt}       sigma2 {c |}{col 15}{res}{space 2} .0517884{col 27}{space 2} .0403967{col 55}{space 4}-.0273877{col 68}{space 3} .1309646
