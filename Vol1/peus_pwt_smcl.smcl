{txt}    Variable {c |}        Obs        Mean    Std. dev.       Min        Max
{hline 13}{c +}{hline 57}
epsilonTLc~d {c |}{res}         38   -.0007444    .0204378  -.0915753   .0548846
{txt}
{com}. scalar m3 = r(mean)
{txt}
{com}. scalar nobs = r(N)
{txt}
{com}. 
. scalar m3t = m3/sqrt(6*m2^3/nobs)
{txt}
{com}.                                 /* negative skewness, so one-side test */
. scalar p_m3t = normal(m3t)
{txt}
{com}. 
.                                         /* correct 3rd moment to be negative */
. scalar m3 = cond(r(sum) < 0, m3, -.0001)
{txt}
{com}. 
. scalar sigmaUsq = (m3/(sqrt(2/_pi)*(1-4/_pi)))^(2/3)
{txt}
{com}. scalar sigmaVsq = m2 - (1-2/_pi)*sigmaUsq
{txt}
{com}. scalar sigmaVsq = cond( sigmaVsq > 0, sigmaVsq, .0001)
{txt}
{com}. 
. scalar mu = sqrt(sigmaUsq*2/_pi)
{txt}
