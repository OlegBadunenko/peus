{txt}  3{com}.         if `first_col' == . local first_col = `col_num'
{txt}  4{com}.         local last_col = `col_num'
{txt}  5{com}.     {c )-}
{txt}  6{com}.     local col_num = `col_num' + 1
{txt}  7{com}. {c )-}
